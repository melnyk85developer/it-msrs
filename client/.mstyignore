# Игнорировать все файлы
*.log

# Игнорируйте всю папку
node_modules/
dist/
static/
img/
images/
image/
psd/
sidebar/
smiles/
assets/

temp/

# Игнорировать все файлы .tmp в любом каталоге
**/*.tmp

# Игнорируйте все файлы в папке
drafts/

# Но не игнорируйте важные черновики
!drafts/important_draft.md

# Игнорируйте все файлы, начинающиеся с 'temp_'
temp_*

# Игнорируйте все файлы, заканчивающиеся на '_old'
*_old
