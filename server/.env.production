#INFRASTRUCTURE + SECRETS + DANGEROUS CONFIGURATION

#Имя приложения
PROJEKT_NAME=
#Порт на котором запускаеися приложение
PORT=

#URI Для основной базы данных Mongo
MONGO_URI=

#Возмите из панели секрет для PayPal
PAYMENT_PAYPAL_SECRET=

#Опасные настройки, если true, то все зарегистрированные пользователи будут автоматически подтверждены, для production нужно false
IS_USER_AUTOMATICALLY_CONFORMED=

#Должен ли быть открыт Swagger
IS_SWAGGER_ENABLED=

# Если true, то некоторые инструменты внутри кода (typeorm) будут автоматически синхронизировать схему кода с базой данных (опасно) для production ...
DB_AUTOSYNC=

#Тестовый модуль предоставляет контроллеры и логику для облегчения тестирования, на пример УДАЛИТЬ ВСЕ ДАННЫЕ, Опасно, для большенства окружений должно быть false
INCLUDE_TESTING_MODULE=




