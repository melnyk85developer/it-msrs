#INFRASTRUCTURE + SECRETS + DANGEROUS CONFIGURATION
#Имя приложения
PROJEKT_NAME=PANDORA
#Порт на котором запускаеися приложение
PORT=5000
#URI Для основной базы данных Mongo
MONGO_URI=
#URI Для дополнительной (локальной) базы данных Mongo
DB_URL=mongodb://localhost/it-incubator-project
#Возмите из панели секрет для PayPal
PAYMENT_PAYPAL_SECRET=fake_secret
#Опасные настройки, если true, то все зарегистрированные пользователи будут автоматически подтверждены, для production нужно false
IS_USER_AUTOMATICALLY_CONFORMED=true
#Должен ли быть открыт Swagger
IS_SWAGGER_ENABLED=true
#Тестовый модуль предоставляет контроллеры и логику для облегчения тестирования, на пример УДАЛИТЬ ВСЕ ДАННЫЕ, Опасно, для большенства окружений должно быть false
INCLUDE_TESTING_MODULE=false
# Если true, то некоторые инструменты внутри кода (typeorm) будут автоматически синхронизировать схему кода с базой данных (опасно) для production ...
DB_AUTOSYNC=
#Имя хоста POSTGRESQL базы данных
POSTGRES_HOST=localhost
#Имя пользователя POSTGRESQL базы данных
POSTGRES_USER=postgres
#Имя базы данных
POSTGRES_DB=it-mars
#Пароль базы данных
POSTGRES_PASSWORD=masikus
#Порт на котором крутится POSTGRESQL база данных
POSTGRES_PORT=5432
#Секрет ключ
PRIVATE_KEY=secret_key_qwertyytrewq
#Секрет JWT аксес-токента
JWT_ACCESS_SECRET=jwt-secret-key
#Секрет JWT рефрешь-токента
JWT_REFRESH_SECRET=jwt-refresh-secret-key
#Адрес хоста smtp
SMTP_HOST="smtp.gmail.com"
#№ Порта smtp
SMTP_PORT=587
#E-Mail адрес smtp пользователя
SMTP_USER=melnikmaksfisher@gmail.com
#Пароль smtp
SMTP_PASSWORD=cmzm kiib jzrr mzqf
#API_URL бекенд запускаемого приложения
API_URL=http://localhost:5006
#CLIENT_URL фронтенд запускаемого приложения
CLIENT_URL=http://localhost:3000
#APPLICATION/DOMAIN SETTINGS
# Сколько новый блогер может сделать постов до того, как его аппрувят
BLOGS_MAX_POSTS_COUNT_BEFORE_MODERATION=10