# test.env
#INFRASTRUCTURE + SECRETS + DANGEROUS CONFIGURATION
PROJEKT_NAME=it-example-test
PORT=9999
#URI Для дополнительной (локальной) базы данных Mongo
DB_URL=mongodb://localhost/example-db-project

#Секрет ключ
PRIVATE_KEY=secret_key_qwertyytrewq_example
#Секрет JWT аксес-токента
JWT_ACCESS_SECRET=example-secret-key-jwt
#Секрет JWT рефрешь-токента
JWT_REFRESH_SECRET=example-refresh-secret-key-jwt

#Адрес хоста smtp
SMTP_HOST="smtp.gmail.com"
#№ Порта smtp
SMTP_PORT=587
#E-Mail адрес smtp пользователя
SMTP_USER=example@gmail.com
#Пароль smtp
SMTP_PASSWORD=example cmzm mzqf jzrr kiib 
#API_URL бекенд запускаемого приложения
API_URL=http://localhost:9000
#CLIENT_URL фронтенд запускаемого приложения
CLIENT_URL=http://localhost:8000

#Должен ли быть открыт Swagger
IS_SWAGGER_ENABLED=false
#Тестовый модуль предоставляет контроллеры и логику для облегчения тестирования, на пример УДАЛИТЬ ВСЕ ДАННЫЕ, Опасно, для большенства окружений должно быть false
INCLUDE_TESTING_MODULE=false
IS_USER_AUTOMATICALLY_CONFIRMED=false
ACCESS_TOKEN_SECRET=secretOrKey_forTest
REFRESH_TOKEN_SECRET=secretOrKey_forTest
SEND_INTERNAL_SERVER_ERROR_DETAILS=false

#APPLICATION/DOMAIN SETTINGS
# for testing purposes this section must be empty